ENVIRONMENT=dev
LOG_LEVEL=DEBUG
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ADMIN_ID=123456789

# Base64-encoded Google service-account JSON for Azure. Local development falls back to credentials.json.
SERVICE_ACCOUNT_BASE64=
SPREADSHEET_ID=

# Relative paths are resolved from the project root.
DATABASE_PATH=src/db/timetable.db
SCHEDULE_SNAPSHOTS_DIR=schedule_snapshots

# Snapshot retention is applied per spreadsheet.
MAX_SCHEDULE_SNAPSHOTS=25
SNAPSHOT_CLEANUP_INTERVAL_SECONDS=86400

# Parser chain is selected in src/parser/registry.py; awful_uni_grid is always the final fallback.
SCHEDULE_PARSER=awful_uni_grid
CHECK_INTERVAL_SECONDS=43200