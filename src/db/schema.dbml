Table groups {
    id integer [primary key]
    study_form text [not null]
    enrollment_year integer [not null]
    group_name text [not null]
}

Table spreadsheets {
    id integer [primary key]
    group_id integer [not null, ref: > groups.id]
    sheet_id text [not null, unique]
    is_active boolean [not null, default: `true`]
    last_hash text
    updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table users {
    chat_id integer [primary key]
    group_id integer [not null, ref: > groups.id]
    username text
    first_name text
    is_banned boolean [not null, default: `false`]
    locale text [not null, default: 'ru']
    notifications_enabled boolean [not null, default: `true`]
    created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table schedule_lectures {
    id integer [primary key]
    sheet_id text [not null]
    group_id integer [not null, ref: > groups.id]
    lecture_date text [not null]
    time text
    subject text [not null]
    room text
    teacher text
    form text
    hours real
    course_year integer
    level text
    delivery_mode text
    course_notes text
    cell_note text
}

Table schedule_cache {
    sheet_id integer [primary key]
    snapshot_path text [not null]
    content_hash text [not null]
    academic_year text [not null]
    loaded_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table pending_submissions {
    id integer [primary key]
    group_id integer [not null, ref: > groups.id]
    group_name text [not null]
    sheet_id text [not null]
    user_chat_id integer [not null, ref: > users.chat_id]
}

Table pending_notifications {
    id integer [primary key]
    notification_type text [not null]
    notification_key text [not null]
    sheet_id text [not null]
    content_hash text [not null]
    group_id integer [not null, ref: > groups.id]
    group_name text [not null]
    chat_id integer [not null, ref: > users.chat_id]
    scheduled_for timestamp [not null]
    created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
    delivered_at timestamp
}